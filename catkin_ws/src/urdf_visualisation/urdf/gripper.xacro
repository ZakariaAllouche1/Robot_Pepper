<?xml version="1.0"?>

<robot name="gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

 		<link name="gripper">
 		<visual>
     		<origin rpy="0.0 0 0" xyz="0 0 0"/>
      		<geometry>
        		<mesh filename="package://dsr_description/xacro/Pierre.STL" scale="0.01 0.01 0.01" />

      		</geometry>
 
    	</visual>
