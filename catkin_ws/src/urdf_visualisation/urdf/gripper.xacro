  		<joint name="gripper_joint" type="fixed">
    		<origin xyz="0.025 -0.025 0.06" rpy="0 ${pi} 0" />
    		<parent link="link6"/>
    		<child link="gripper"/>
  		</joint>
  	

</robot>
